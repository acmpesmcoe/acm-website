# ═══════════════════════════════════════════════════════════════════
# ACM PES MCOE — Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════
#
# This file lists EVERY env variable used across all three apps.
# It lives at the repo root purely for quick reference / onboarding.
#
# Each app reads its OWN .env file:
#   apps/server/.env   (Node/Express — uses dotenv)
#   apps/web/.env      (Vite — reads VITE_* automatically)
#   apps/admin/.env    (Vite — reads VITE_* automatically)
#
# Copy the relevant variables into each app's .env file.
# ═══════════════════════════════════════════════════════════════════

# ── apps/server ────────────────────────────────────────────────────

# MongoDB Atlas connection string (see apps/server/README.md for setup)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/acm-website

# Any long random string — used to sign JWT login tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# Port the server runs on locally
PORT=5000

# Comma-separated list of frontend URLs allowed to call this API
# Include BOTH the public site and admin dashboard, dev AND prod URLs
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-site.vercel.app,https://your-admin.vercel.app

# Used only once, by `npm run seed:admin`, to create your first admin login
SEED_ADMIN_NAME=Your Name
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-password

# ── apps/web ───────────────────────────────────────────────────────

# Backend API URL (local dev or deployed)
VITE_API_URL=http://localhost:5000/api

# Admin dashboard URL (used for the admin link in the navbar)
VITE_ADMIN_URL=http://localhost:5174

# ── apps/admin ─────────────────────────────────────────────────────

# Backend API URL (local dev or deployed)
VITE_API_URL=http://localhost:5000/api
