# apps/web uses lucide-react@0.383.0 which has a peer dep on react@^16||^17||^18
# but the project uses React 19. This is a known compat issue (lucide-react
# works fine with React 19, just hasn't updated its peer dep range).
# TODO: Upgrade lucide-react in apps/web to ^1.x to match apps/admin, then remove this.
legacy-peer-deps=true
